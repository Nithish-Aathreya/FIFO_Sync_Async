`include"fifo_design.v"

module tb;

parameter WIDTH=8;
parameter DEPTH=16; 
parameter PTR_WIDTH=$clog2(DEPTH); 


reg clk,rst;
reg[WIDTH-1:0]data_i;
wire[WIDTH-1:0]data_o;
reg wr_valid,rd_valid;
wire fifo_full,fifo_empty,error;
integer i,j,k,delay;
reg[200:1]testname;


fifo_design dut(clk, rst, data_i, data_o, wr_valid, rd_valid, fifo_full, fifo_empty, error);

initial
begin
    clk=0;
    forever #5 clk=~clk;
end

initial
begin
    reset();
    $value$plusargs("testname=%0s",testname);
    $display("testname=%0s",testname);
//    write(DEPTH);
  //read(DEPTH);
case(testname)
    "FIFO_FULL":begin
        write(DEPTH);
    end

    "FIFO_EMPTY":begin
        write(DEPTH);
        read(DEPTH);
    end
    
    "FIFO_FULL_ERROR":begin
    write(DEPTH+1);
    end
    
    "FIFO_EMPTY_ERROR":begin
    write(DEPTH);
    read(DEPTH+1);
    end
    
    "random_write_random_read":begin
            for(j=0;j<DEPTH;j=j+1)
            begin
              delay = $urandom_range(1,10);
        fork
        begin
            
        #delay    write(1);
            end
    begin
         #delay   read(1);
    end
join
end

end
endcase
#100;
$finish;
end

task reset();
    begin
    rst=1;
    data_i=0;
    wr_valid=0;
    rd_valid=0;
    @(posedge clk)
    rst=0;
    end
endtask

task write(input integer num_loc);
    begin
for(i=0;i<num_loc;i=i+1)
begin
    @(posedge clk)
wr_valid=1;
data_i=$random;
end
@(posedge clk)
wr_valid=0;
data_i=0;
    end
endtask

task read(input integer num_loc);
    begin

for(i=0;i<num_loc;i=i+1)
begin
    @(posedge clk)
rd_valid=1;
end
@(posedge clk)
rd_valid=0;
    end
endtask


endmodule
