module async(wr_clk,rd_clk, rst, data_i, data_o, wr_valid, rd_valid, fifo_full, fifo_empty, error);

parameter WIDTH=8;
parameter DEPTH=16; 
parameter PTR_WIDTH=$clog2(DEPTH); 


input wr_clk,rd_clk,rst;
input [WIDTH-1:0]data_i;
output reg[WIDTH-1:0]data_o;
input wr_valid,rd_valid;
output reg fifo_full,fifo_empty,error;
integer i;


reg [PTR_WIDTH-1:0]wr_ptr;
reg [PTR_WIDTH-1:0]rd_ptr;
reg wr_t_f,rd_t_f;

reg wr_t_f_rd_clk,rd_t_f_wr_clk;
//reg [PTR_WIDTH-1:0]wr_ptr_rd_clk;
//reg [PTR_WIDTH-1:0]rd_ptr_wr_clk;
reg [PTR_WIDTH-1:0]wr_ptr_gray_rd_clk;
reg [PTR_WIDTH-1:0]rd_ptr_gray_wr_clk;
reg [PTR_WIDTH-1:0]wr_ptr_gray;
reg [PTR_WIDTH-1:0]rd_ptr_gray;





reg[WIDTH-1:0]mem[DEPTH-1:0];

always@(posedge wr_clk)
    begin
        if(rst)
        begin
        data_o=0;
        fifo_full=0;
        fifo_empty=1;
        error=0;
        wr_ptr<=0;
        rd_ptr<=0;
        rd_t_f<=0;
        wr_t_f<=0;
        wr_t_f_rd_clk=0;
        rd_t_f_wr_clk=0;
    //    wr_ptr_rd_clk=0;
      //  rd_ptr_wr_clk=0;
        for(i=0;i<DEPTH;i=i+1)
            mem[i]=0;
        end
        else     //rst==0
        begin
            error=0;
            if(wr_valid)
                begin
                    if(fifo_full) begin
                        error=1;
                    end
                    else
                    begin
                        mem[wr_ptr]=data_i;
                        if(wr_ptr==DEPTH-1)
                        begin
                            wr_t_f=~wr_t_f;
                          //  wr_ptr=0;
                        end
                            wr_ptr=wr_ptr+1; 
                        wr_ptr_gray={wr_ptr[3],wr_ptr[3:1]^wr_ptr[2:0]};
                    end //else
                end //wr_valid
                end //rst==0
            
            end //always block

always@(posedge rd_clk)
begin
    if(rst==0)
    begin
                        error=0;
            if(rd_valid)
                begin
                    if(fifo_empty) begin
                        error=1;
                    end
                    else
                    begin
                        data_o=mem[rd_ptr];
                        if(rd_ptr==DEPTH-1)
                        begin
                            rd_t_f=~rd_t_f;
                            //rd_ptr=0;
                        end
                            rd_ptr=rd_ptr+1; 
                        rd_ptr_gray={rd_ptr[3],rd_ptr[3:1]^rd_ptr[2:0]};
                        end //else
                    end  //rd_valid

        end  //rst==0
    end  //always block

//synchronisation
    always@(posedge rd_clk) //for empty condition 
    begin
    wr_ptr_gray_rd_clk<=wr_ptr_gray;
    wr_t_f_rd_clk<=wr_t_f;
    end

    always@(posedge wr_clk) //for full condition 
    begin
    rd_ptr_gray_wr_clk<=rd_ptr_gray;
    rd_t_f_wr_clk<=rd_t_f;
    end

always@(*)
begin
    fifo_empty=0;
    if(wr_ptr_gray_rd_clk==rd_ptr_gray && wr_t_f_rd_clk==rd_t_f ) begin
    fifo_empty=1;
end
end

always@(*)
begin
    fifo_full=0;
if(wr_ptr_gray==rd_ptr_gray_wr_clk && wr_t_f!=rd_t_f_wr_clk)
begin
    fifo_full=1;
end
end
    endmodule

