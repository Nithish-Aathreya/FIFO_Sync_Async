module fifo_design(clk, rst, data_i, data_o, wr_valid, rd_valid, fifo_full, fifo_empty, error);

parameter WIDTH=8;
parameter DEPTH=16; 
parameter PTR_WIDTH=$clog2(DEPTH); 


input clk,rst;
input [WIDTH-1:0]data_i;
output reg[WIDTH-1:0]data_o;
input wr_valid,rd_valid;
output reg fifo_full,fifo_empty,error;
integer i;

reg [PTR_WIDTH-1:0]wr_ptr;
reg [PTR_WIDTH-1:0]rd_ptr;
reg wr_t_f,rd_t_f;
reg[WIDTH-1:0]mem[DEPTH-1:0];

always@(posedge clk)
    begin
        if(rst)
        begin
        data_o=0;
        fifo_full=0;
        fifo_empty=1;
        error=0;
        wr_ptr<=0;
        rd_ptr<=0;
        rd_t_f<=0;
        wr_t_f<=0;
        for(i=0;i<DEPTH;i=i+1)
            mem[i]=0;
        end
        else     //rst==0
        begin
            error=0;
            if(wr_valid)
                begin
                    if(fifo_full) begin
                        error=1;
                    end
                    else
                    begin
                        mem[wr_ptr]=data_i;
                        if(wr_ptr==DEPTH-1)
                        begin
                            wr_t_f=~wr_t_f;
                          //  wr_ptr=0;
                        end
                            wr_ptr=wr_ptr+1; 
                    end
                end //wr_valid

            if(rd_valid)
                begin
                    if(fifo_empty) begin
                        error=1;
                    end
                    else
                    begin
                        data_o=mem[rd_ptr];
                        if(rd_ptr==DEPTH-1)
                        begin
                            rd_t_f=~rd_t_f;
                            //rd_ptr=0;
                        end
                            rd_ptr=rd_ptr+1; 
                        end
                    end  //rd_valid

        end  //rst==0
    end  //always block

always@(*)
begin
    fifo_empty=0;
    fifo_full=0;
    if(wr_ptr==rd_ptr && wr_t_f==rd_t_f ) begin
    fifo_empty=1;
end
if(wr_ptr==rd_ptr && wr_t_f!=rd_t_f)
begin
    fifo_full=1;
end
end
    endmodule
